# ==========================================
# AiGeneratorApi local environment example
# Copy to AiGeneratorApi/.env for local development, or inject as real environment variables in production.
# Do not commit real API keys.
# ==========================================

# API access key. Clients must send this value in header: x-api-key
MY_API_KEY=change-me

# Comma-separated allowlist. Use "*" only for trusted development/testing environments.
IP_WHITELIST=127.0.0.1,::1

# ==========================================
# NewAPI / LiteLLM / NVIDIA NIM channel
# ==========================================
AIConfig__NewApi__BaseUrl=https://api.zxaihub.com
AIConfig__NewApi__DefaultModelId=z-ai/glm-5.2
AIConfig__NewApi__FetchRemoteModels=false
AIConfig__NewApi__RequestTimeoutSeconds=300
AIConfig__NewApi__ModelListTimeoutSeconds=10

# Configure at least one key. Leave the other empty if not used.
AIConfig__NewApi__FreeApiKey=
AIConfig__NewApi__VipApiKey=

# Optional array override example:
# AIConfig__NewApi__Models__0=z-ai/glm-5.2
# AIConfig__NewApi__FallbackModels__0=z-ai/glm-5.2

# ==========================================
# Google Gemini provider
# Disabled by default. Keep code compatibility, but do not depend on it unless explicitly enabled.
# ==========================================
AIConfig__Gemini__Enabled=false
AIConfig__Gemini__ProjectId=
AIConfig__Gemini__Location=us-central1
AIConfig__Gemini__DefaultModelId=gemini-2.5-flash
AIConfig__Gemini__KeyFilePath=
AIConfig__Gemini__ProxyUrl=
